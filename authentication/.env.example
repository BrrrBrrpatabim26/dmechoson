# ==============================================================================
# BIẾN MÔI TRƯỜNG DỊCH VỤ XÁC THỰC (AUTHENTICATION SERVICE)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cấu hình Ứng dụng & API Versioning
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
# Tự động tăng port khi cổng bị chiếm (EADDRINUSE): true | false
PORT_AUTO_INCREMENT=true
# Số lần thử cổng tối đa khi tự động tăng port
PORT_MAX_ATTEMPTS=20
# (docker-compose) Cổng HOST công bố cho auth-service; đổi nếu 3001 bị service khác chiếm.
#   Du dung:  AUTH_HOST_PORT=3099 docker compose up -d
AUTH_HOST_PORT=3001
# (docker-compose) Tag image cụ thể (KHÔNG dùng latest - AGENTS 1.2 #5).
IMAGE_TAG=0.0.1
APP_NAME=Authentication Service
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Cấu hình Cơ sở dữ liệu Đa hình (Polymorphic Database Configuration)
# ------------------------------------------------------------------------------
# Loại Database: 'postgres' hoặc 'mysql' (Hệ thống tự động nạp Strategy phù hợp)
DB_TYPE=postgres

# Địa chỉ máy chủ Database:
# - Chạy 'npm run start:dev' trên máy Host (Windows/Mac): sử dụng 'localhost' hoặc '127.0.0.1'
# - Chạy toàn bộ trong Docker Compose: sử dụng tên service 'postgres'
# - Chạy container muốn kết nối tới database đang chạy trên máy Host: sử dụng 'host.docker.internal'
DB_HOST=localhost

# Cổng Database (PostgreSQL: 5432, MySQL: 3306)
DB_PORT=5432

# (docker-compose) Cổng HOST công bố cho postgres; đổi nếu 5432 bị chiếm.
#   tách bạch với DB_PORT (cổng nội bộ container trong mạng compose).
DB_HOST_PORT=5432

DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=authentication
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false
# Chay migration tu dong luc boot (them index/schema khi DB_SYNCHRONIZE=false). Mac dinh tat.
DB_RUN_MIGRATIONS=false
# Connection pool: so ket noi toi thieu/toi da + thoi gian nhoi (ms).
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE_MS=30000

# ------------------------------------------------------------------------------
# 3. Cấu hình JSON Web Token & Refresh Token (JWT Settings)
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-key-for-auth-service-2026-production-ready
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# ------------------------------------------------------------------------------
# 4. Cấu hình Thuật toán băm mật khẩu Đa hình (Password Hashing Polymorphism)
# ------------------------------------------------------------------------------
# Thuật toán mặc định: 'argon2id' hoặc 'bcrypt'
HASH_DEFAULT_ALGORITHM=argon2id
HASH_ARGON2_MEMORY_COST=65536
HASH_ARGON2_TIME_COST=3
HASH_ARGON2_PARALLELISM=1
HASH_BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 5. Cấu hình Tài liệu API Swagger (Swagger UI)
# ------------------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ------------------------------------------------------------------------------
# 6. Bật/Tắt Phương thức Xác thực & Email Verification
# ------------------------------------------------------------------------------
AUTH_ENABLED_METHODS=password,email_otp,phone_otp,magic_link,google,github,passkey
AUTH_EMAIL_VERIFICATION_ENABLED=false
AUTH_RBAC_CACHE_TTL_MS=60000
# Bootstrap phong SUPER_ADMIN cho email khoanh mien luc boot (csv). De TRONG = tat.
# Dung MỘT LẦN khi fresh-deploy để có admin đầu tiên, sau đó XOA khỏi env (grant luc boot co log).
ADMIN_BOOTSTRAP_EMAILS=
# Role toan quyen (csv) — guard/lockout doc tu env, KHONG hard-code trong code.
# Vi du: SUPER_ADMIN,CHIEF_OFFICER (bo sung/doi ten role chi can sua env + restart + seed tu dong ton trong role).
SUPER_ADMIN_ROLES=SUPER_ADMIN
# Ten role mac dinh cap cho user moi signup (role duoc bootstrap seed dong nay trong DB).
DEFAULT_USER_ROLE=USER

# ------------------------------------------------------------------------------
# 7. Rate Limiting (Chống Brute-Force cấp tầng HTTP)
# ------------------------------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=20

# ------------------------------------------------------------------------------
# 8. OAuth 2.0 Providers (chỉ bật khi có credentials thật)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback

# ------------------------------------------------------------------------------
# 9. MFA / TOTP & Passkey (WebAuthn)
# ------------------------------------------------------------------------------
MFA_ISSUER=AgentCloud Auth
MFA_RECOVERY_CODE_COUNT=8
# Khoa AES-256-GCM chuyen dung de ma hoa TOTP secret. Nen dat rieng (khong trung JWT_SECRET).
# De trong -> app fallback sang JWT_SECRET (van an toan nhung nen tach bach).
MFA_ENCRYPTION_KEY=change-me-dedicated-32bytes-encryption-key
WEBAUTHN_RP_NAME=AgentCloud
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001

# ------------------------------------------------------------------------------
# 12. Redis ( tuy chon ) - BAT/TAT bang ON_REDIS
# ------------------------------------------------------------------------------
# ON_REDIS=true  -> RBAC cache, Throttler storage, WebAuthn challenge dung REDIS (scale ngang).
# ON_REDIS=false -> dung in-memory (mac dinh, chi chay duoc 1 instance).
# env LUU UU TIEN hon redis: trong config.yaml.
ON_REDIS=false
# (docker-compose) Cổng HOST công bố cho redis (chỉ dùng khi bật profile 'redis').
REDIS_HOST_PORT=6379
# Hoac chi dinh URL day du (uu tien cao nhat khi co):
# REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# 13. Cứng hoa Bao mat / Van hanh (mac dinh an toan trong code; chi override khi can)
# ------------------------------------------------------------------------------
# So hop proxy tin cay dung sau phan giải (0/false = khong tin X-Forwarded-For).
#   Sau 1 nginx -> TRUST_PROXY=1.  Co the dat danh sach subnet/ten cach nhau dau phay.
TRUST_PROXY=
# Allowlist origin CORS (cach nhau dau phay). Trong o non-prod -> phan anh moi origin; o prod -> dong.
#   Vi du: https://app.example.com,https://admin.example.com
CORS_ORIGIN=
# Bat sinh `state` chong CSRF cho OAuth (can express-session). Mac dinh false.
# Chong CSRF cho OAuth initiation. BAT MAC DINH (state luu KeyValueStore + cookie httpOnly, khong can express-session). Chi tat khi co ly do su kien roi (vd demo headless).
OAUTH_STATE=true
# Tuy chon tat xac thuc cert TLS (chi dev/self-signed). Mac dinh: xac thuc (an toan).
SMTP_TLS_INSECURE=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Timeout (ms) cho cac giao tiep ngoai.
SMTP_TIMEOUT_MS=10000
DB_POOL_CONNECT_TIMEOUT_MS=10000
HTTP_KEEPALIVE_TIMEOUT_MS=65000
